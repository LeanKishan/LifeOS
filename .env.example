# Copy to .env and adjust: `cp .env.example .env`
# Docker Compose auto-loads .env from this directory.

# --- Postgres ---
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

# --- Backend ---
# With no DATABASE_URL set, the backend uses a local SQLite file
# (backend/lifeos.db) - nothing to install. Uncomment to use Postgres instead
# (Docker Compose sets this for its own containers automatically):
#   DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development

# Generate a real one with:  openssl rand -hex 32   (required in production)
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
