# Copy to .env and adjust: `cp .env.example .env`
# Docker Compose auto-loads .env from this directory.

# --- Postgres ---
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

# --- Backend ---
# With no DATABASE_URL / REDIS_URL set, the backend uses a local SQLite file
# (backend/lifeos.db) and an in-process fake Redis - nothing to install.
# Uncomment to use the real thing (Docker Compose sets these for its containers):
#   DATABASE_URL=postgresql+psycopg://lifeos:lifeos@localhost:5432/lifeos
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development

# Celery: unset / true = tasks run inline (no worker needed). Compose sets false
# and runs a real worker + beat against the Redis broker.
CELERY_EAGER=true

# AI assistant: without a key the /coach endpoint returns 503; everything else runs.
ANTHROPIC_API_KEY=

# Generate a real one with:  openssl rand -hex 32   (required in production)
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
